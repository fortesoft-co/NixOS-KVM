From 168b9392a1f7d4f1f2663f169a8e84a756bf13b5 Mon Sep 17 00:00:00 2001
From: nixos-kvm <nixos-kvm@localhost>
Date: Wed, 29 Jul 2026 06:58:21 -0500
Subject: [PATCH] KVM: VMX: spoof guest TSC timing (RDTSC/RDTSCP/UMWAIT/TPAUSE)

Anti-detection: intercept guest RDTSC/RDTSCP and scale the user-mode
visible TSC by a runtime divisor, compressing VM-exit timing overhead
into the guest's noise floor. UMWAIT/TPAUSE are skipped outright.

- Force CPU_BASED_RDTSC_EXITING on (moved from OPTIONAL to REQUIRED
  exec controls)
- handle_rdtsc: CPL/protmode-gated divisor applied to the TSC scaling
  ratio; kernel-mode (CPL 0) reads pass through the real scaled TSC
- handle_rdtscp: same, with correct TSC_AUX (VPID) semantics in RCX
- handle_umwait/handle_tpause: skip (WAITPKG timing tricks)
- Open-coded kvm_scale_tsc0 helpers (no KVM export surface changes)
- module_params: rdtsc_spoof_enable (bool, default true),
  rdtsc_user_divisor (uint, default 8, clamped to [1,1024], 0 = default)

Lineage: RDTSC core from dmfrpro's Hypervisor-Phantom
zen-6.14.10-vmx.patch (scaling family); module_param pattern from
KBapna's PVE-Kernel-Patches RDTSC.patch. Rebased onto Linux 6.18.38.
---
 arch/x86/kvm/vmx/vmx.c | 96 +++++++++++++++++++++++++++++++++++++++++-
 arch/x86/kvm/vmx/vmx.h |  4 +-
 2 files changed, 96 insertions(+), 4 deletions(-)

diff --git a/arch/x86/kvm/vmx/vmx.c b/arch/x86/kvm/vmx/vmx.c
index b7798ce..0cd4a93 100644
--- a/arch/x86/kvm/vmx/vmx.c
+++ b/arch/x86/kvm/vmx/vmx.c
@@ -225,6 +225,31 @@ static const struct {
 #define L1D_CACHE_ORDER 4
 static void *vmx_l1d_flush_pages;
 
+/*
+ * Open-coded copies of x86.c's TSC scaling helpers (suffixed with 0 to avoid
+ * clashing with the static originals). Open-coding keeps KVM's export surface
+ * unchanged -- no EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_scale_tsc) needed.
+ */
+static __always_inline u64 mul_u64_u64_shr0(u64 a, u64 mul, unsigned int shift)
+{
+	return (u64)(((unsigned __int128)a * mul) >> shift);
+}
+
+static inline u64 __scale_tsc0(u64 ratio, u64 tsc)
+{
+	return mul_u64_u64_shr0(tsc, ratio, kvm_caps.tsc_scaling_ratio_frac_bits);
+}
+
+static inline u64 kvm_scale_tsc0(u64 tsc, u64 ratio)
+{
+	u64 _tsc = tsc;
+
+	if (ratio != kvm_caps.default_tsc_scaling_ratio)
+		_tsc = __scale_tsc0(ratio, tsc);
+
+	return _tsc;
+}
+
 static int vmx_setup_l1d_flush(enum vmx_l1d_flush_state l1tf)
 {
 	struct page *page;
@@ -4440,11 +4465,13 @@ static u32 vmx_exec_control(struct vcpu_vmx *vmx)
 	 * Not used by KVM, but fully supported for nesting, i.e. are allowed in
 	 * vmcs12 and propagated to vmcs02 when set in vmcs12.
 	 */
-	exec_control &= ~(CPU_BASED_RDTSC_EXITING |
-			  CPU_BASED_USE_IO_BITMAPS |
+	exec_control &= ~(CPU_BASED_USE_IO_BITMAPS |
 			  CPU_BASED_MONITOR_TRAP_FLAG |
 			  CPU_BASED_PAUSE_EXITING);
 
+	/* Anti-detection: ensure handle_rdtsc() intercepts guest RDTSC. */
+	exec_control |= CPU_BASED_RDTSC_EXITING;
+
 	/* INTR_WINDOW_EXITING and NMI_WINDOW_EXITING are toggled dynamically */
 	exec_control &= ~(CPU_BASED_INTR_WINDOW_EXITING |
 			  CPU_BASED_NMI_WINDOW_EXITING);
@@ -6105,6 +6132,67 @@ static int handle_wrmsr_imm(struct kvm_vcpu *vcpu)
 				     vmx_get_msr_imm_reg(vcpu));
 }
 
+/*
+ * Anti-detection: spoof guest-visible TSC timing.
+ *
+ * User-mode RDTSC/RDTSCP reads are the classic VM-exit timing probe (pafish,
+ * Al-Khaser, VMAware): a bare-metal RDTSC costs ~20-30 cycles, an intercepted
+ * one costs thousands. Scaling the user-mode-visible TSC down by a divisor
+ * compresses the exit overhead into the guest's noise floor. Kernel-mode
+ * (CPL 0) reads pass through the real scaled TSC so guest kernel timekeeping
+ * is unaffected. UMWAIT/TPAUSE are skipped outright (WAITPKG timing tricks).
+ *
+ * Stateless: pure function of hardware TSC + existing vcpu->arch fields.
+ */
+static bool rdtsc_spoof_enable = true;
+MODULE_PARM_DESC(rdtsc_spoof_enable,
+		 "Spoof user-mode guest TSC timing (anti VM-exit timing detection)");
+module_param(rdtsc_spoof_enable, bool, 0644);
+
+static uint rdtsc_user_divisor = 8;
+MODULE_PARM_DESC(rdtsc_user_divisor,
+		 "TSC scaling divisor for user-mode guest reads (clamped to [1,1024], 0 = default 8)");
+module_param(rdtsc_user_divisor, uint, 0644);
+
+static int handle_rdtsc(struct kvm_vcpu *vcpu)
+{
+	u64 offset = vcpu->arch.tsc_offset;
+	u64 ratio = vcpu->arch.tsc_scaling_ratio;
+	u64 rdtsc_fake;
+	u32 divisor = rdtsc_user_divisor;
+
+	/* keep in sync with the MSR_IA32_TSC path's compiled-in default (x86.c) */
+	if (divisor == 0 || divisor > 1024)
+		divisor = 8;
+
+	if (rdtsc_spoof_enable &&
+	    (vmx_get_cpl(vcpu) != 0 || !is_protmode(vcpu)))
+		ratio /= divisor;
+
+	rdtsc_fake = kvm_scale_tsc0(rdtsc(), ratio) + offset;
+
+	vcpu->arch.regs[VCPU_REGS_RAX] = rdtsc_fake & -1u;
+	vcpu->arch.regs[VCPU_REGS_RDX] = (rdtsc_fake >> 32) & -1u;
+
+	return skip_emulated_instruction(vcpu);
+}
+
+static int handle_rdtscp(struct kvm_vcpu *vcpu)
+{
+	vcpu->arch.regs[VCPU_REGS_RCX] = vmcs_read16(VIRTUAL_PROCESSOR_ID);
+	return handle_rdtsc(vcpu);
+}
+
+static int handle_umwait(struct kvm_vcpu *vcpu)
+{
+	return skip_emulated_instruction(vcpu);
+}
+
+static int handle_tpause(struct kvm_vcpu *vcpu)
+{
+	return skip_emulated_instruction(vcpu);
+}
+
 /*
  * The exit handlers return 1 if the exit was handled fully and guest execution
  * may resume.  Otherwise they set the kvm_run parameter to indicate what needs
@@ -6167,6 +6255,10 @@ static int (*kvm_vmx_exit_handlers[])(struct kvm_vcpu *vcpu) = {
 	[EXIT_REASON_TDCALL]		      = handle_tdx_instruction,
 	[EXIT_REASON_MSR_READ_IMM]            = handle_rdmsr_imm,
 	[EXIT_REASON_MSR_WRITE_IMM]           = handle_wrmsr_imm,
+	[EXIT_REASON_RDTSC]                   = handle_rdtsc,
+	[EXIT_REASON_RDTSCP]                  = handle_rdtscp,
+	[EXIT_REASON_UMWAIT]                  = handle_umwait,
+	[EXIT_REASON_TPAUSE]                  = handle_tpause,
 };
 
 static const int kvm_vmx_max_exit_handlers =
diff --git a/arch/x86/kvm/vmx/vmx.h b/arch/x86/kvm/vmx/vmx.h
index ea93121..2ccd995 100644
--- a/arch/x86/kvm/vmx/vmx.h
+++ b/arch/x86/kvm/vmx/vmx.h
@@ -532,6 +532,7 @@ static inline u8 vmx_get_rvi(void)
 	 CPU_BASED_MONITOR_EXITING |					\
 	 CPU_BASED_INVLPG_EXITING |					\
 	 CPU_BASED_RDPMC_EXITING |					\
+	 CPU_BASED_RDTSC_EXITING |					\
 	 CPU_BASED_INTR_WINDOW_EXITING)
 
 #ifdef CONFIG_X86_64
@@ -545,8 +546,7 @@ static inline u8 vmx_get_rvi(void)
 #endif
 
 #define KVM_OPTIONAL_VMX_CPU_BASED_VM_EXEC_CONTROL			\
-	(CPU_BASED_RDTSC_EXITING |					\
-	 CPU_BASED_TPR_SHADOW |						\
+	(CPU_BASED_TPR_SHADOW |						\
 	 CPU_BASED_USE_IO_BITMAPS |					\
 	 CPU_BASED_MONITOR_TRAP_FLAG |					\
 	 CPU_BASED_USE_MSR_BITMAPS |					\
-- 
2.54.0

